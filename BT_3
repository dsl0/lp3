pragma solidity ^0.8.12;
contract Banking {

mapping(address => uint256) public user_account;
mapping(address => bool) public user_exists;

event AccountCreated(address indexed user, uint256 initialDeposit);
event Deposited(address indexed user, uint256 amount);
event Withdrawn(address indexed user, uint256 amount);
event TransferredInternal(address indexed from, address indexed to, uint256 amount);
event SentExternal(address indexed from, address indexed to, uint256 amount);

modifier onlyExistingAccount() {

require(user_exists[msg.sender], "Account not created");
_;
}
// Create Account
function create_account() public payable returns (string memory) {
require(!user_exists[msg.sender], "Account already created");

user_exists[msg.sender] = true;
user_account[msg.sender] = msg.value;

emit AccountCreated(msg.sender, msg.value);
return "Account created";
}
// Deposit Amount
function deposit() public payable onlyExistingAccount returns (string memory) {
require(msg.value > 0, "Deposit amount should be greater than zero");

user_account[msg.sender] += msg.value;

emit Deposited(msg.sender, msg.value);
return "Deposited Successfully";
}
// Withdraw Amount
function withdraw(uint256 amount) public onlyExistingAccount returns (string memory) {
require(amount > 0, "Amount should be greater than zero");
require(user_account[msg.sender] >= amount, "Insufficient Balance");

// Effects before interaction

user_account[msg.sender] -= amount;

(bool success, ) = payable(msg.sender).call{value: amount}("");
require(success, "Withdrawal transfer failed");

emit Withdrawn(msg.sender, amount);
return "Withdrawal Successful";
}
// Transfer within Bank
function transfer(address userAddress, uint256 amount)
public
onlyExistingAccount
returns (string memory)
{
require(user_exists[userAddress], "Receiver account not created");
require(amount > 0, "Amount should be greater than zero");
require(user_account[msg.sender] >= amount, "Insufficient Balance");

user_account[msg.sender] -= amount;
user_account[userAddress] += amount;

emit TransferredInternal(msg.sender, userAddress, amount);
return "Transfer Successful";
}
// Send Ether to External Address
function send_amt(address payable toAddress, uint256 amount)
public
onlyExistingAccount

returns(string memory)
{
require(amount > 0, "Amount should be greater than zero");
require(user_account[msg.sender] >= amount, "Insufficient Balance");

// Effects before interaction
user_account[msg.sender] -= amount;

(bool success, ) = toAddress.call{value: amount}("");
require(success, "Transfer failed");

emit SentExternal(msg.sender, toAddress, amount);
return "Transfer Successful";
}
// Check Balance
function user_balance() public view onlyExistingAccount returns (uint256) {
return user_account[msg.sender];
}
// Check Account Status
function account_exist() public view returns (bool) {
return user_exists[msg.sender];
}
}
